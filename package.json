{
  "name": "express-zod-guard",
  "version": "3.0.0",
  "description": "Lightweight Express middleware for validating request body, query, and params using Zod with clean error handling.",
  "private": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdev-robin/express-zod-guard.git"
  },
  "keywords": [
    "express",
    "zod",
    "validation",
    "middleware",
    "request-validation",
    "schema-validation",
    "api-validation",
    "typescript",
    "nodejs",
    "backend",
    "input-validation",
    "express-middleware",
    "zod-validation",
    "request-guard",
    "validation-middleware",
    "schema-guard"
  ],
  "author": "jsdev.robin@gmail.com",
  "bugs": {
    "url": "https://github.com/jsdev-robin/express-zod-guard/issues"
  },
  "homepage": "https://github.com/jsdev-robin/express-zod-guard#readme",
  "peerDependencies": {
    "express": "^4 || ^5",
    "zod": "^3 || ^4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "dependencies": {
    "http-errors": "^2.0.1"
  }
}
